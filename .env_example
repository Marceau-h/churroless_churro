CHURROLESS_KEY=dummy
PATH="/path/to/llamacpp/bin:$PATH"
LD_LIBRARY_PATH="/path/to/llamacpp/lib:$LD_LIBRARY_PATH"
CHURROLESS_MODEL="mradermacher/churro-3B-GGUF:IQ4_XS"
CHURROLESS_REPO_PATH="/path/to/this/repo"
CHURROLESS_HOST_URL="http://localhost:8080"
CHURROLESS_CONCURRENCY=10
CHURROLESS_OUTPUT_DIR="$CHURROLESS_REPO_PATH/outputs"
CHURROLESS_PROMPT="Transcribe the entirety of this historical document to XML format."
CHURROLESS_PROMPT_FILE="$CHURROLESS_REPO_PATH/prompts/v0"
CHURROLESS_INPUT_DIR="$CHURROLESS_REPO_PATH/examples/mini_ballard"
CHURROLESS_IMAGE_FORMATS="jpg,png"
CHURROLESS_GLOB_PREFIX=""